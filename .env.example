# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── AI ───
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key

# ─── Flutterwave Payment (CV Download) ───
# Get these from https://dashboard.flutterwave.com/settings/apis
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# ─── CV Download Pricing ───
# Amount charged per CV download (default: 1)
NEXT_PUBLIC_CV_DOWNLOAD_PRICE=1
# Currency code (default: USD). Use your local currency e.g. TZS, KES, NGN, GHS, USD
NEXT_PUBLIC_CV_DOWNLOAD_CURRENCY=USD
